# ============================================================
# TechBoard — Environment Variables
#
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and must NEVER be committed.
# ============================================================

# ---- MySQL Database ----
DB_HOST=localhost          # hostname of the MySQL server (or Docker service name: mysql)
DB_PORT=3306               # MySQL port (default 3306)
DB_USER=techboard_user     # application user (not root)
DB_PASSWORD=your_db_password_here
DB_NAME=techboard

# ---- Node.js Server ----
PORT=3000                  # port the Express server listens on
NODE_ENV=development       # 'development' or 'production' (affects CORS strictness)

# ---- JWT Authentication (Node.js) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string_here

# ---- PHP Admin Panel ----
# Shared secret used to validate PHP → Node requests (Phase 7)
ADMIN_SECRET=replace_with_admin_panel_secret

# ---- Flask Intelligence Engine ----
# Internal URL — use Docker service name when running inside docker-compose
FLASK_URL=http://localhost:5001

# ---- Docker / MySQL root (used only by the mysql Docker container) ----
DB_ROOT_PASSWORD=replace_with_root_password
