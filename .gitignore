# ============================================================
# TechBoard — .gitignore
# ============================================================

# Environment variables — NEVER commit credentials to git
.env
.env.local
.env.production

# Node.js
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
intelligence/__pycache__/
intelligence/analysis/__pycache__/
intelligence/routes/__pycache__/
.Python
*.egg-info/
dist/
*.egg
.pytest_cache/
.venv/
venv/
env/

# Docker
*.tar

# Editor / OS
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# Logs
*.log
logs/

# Data files (large CSVs — download separately per import_instructions.md)
data/stackoverflow_2024.csv
data/stateof_js_2024.json

# Zone identifier files (Windows / WSL artefacts)
*.Zone.Identifier
*:Zone.Identifier
